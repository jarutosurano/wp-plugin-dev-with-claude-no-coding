{
  "ci": {
    "collect": {
      "startServerCommand": "serve ./docs/dist -l 8080",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:8080/wp-plugin-dev-with-claude-no-coding/",
        "http://localhost:8080/wp-plugin-dev-with-claude-no-coding/getting-started/introduction/",
        "http://localhost:8080/wp-plugin-dev-with-claude-no-coding/reference/resources/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
